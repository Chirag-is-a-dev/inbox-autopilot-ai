{
  "name": "AI Email Assistant - 2 Approval and Reply",
  "nodes": [
    {
      "parameters": { "updates": ["messages"], "options": {} },
      "id": "ff67601b-8f85-497e-8b07-0d88f68d3aaf",
      "name": "WhatsApp: Incoming Message",
      "type": "n8n-nodes-base.whatsAppTrigger",
      "typeVersion": 1,
      "position": [240, 304],
      "credentials": { "whatsAppTriggerApi": { "id": "YOUR_CREDENTIAL_ID", "name": "WhatsApp OAuth account" } }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "k1", "name": "ownerWhatsApp", "type": "string", "value": "YOUR_WHATSAPP_NUMBER" },
            { "id": "k2", "name": "phoneNumberId", "type": "string", "value": "YOUR_PHONE_NUMBER_ID" }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "09e3b454-1966-462a-890c-4f28543a77c5",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [480, 304]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "m1", "name": "fromNumber", "value": "={{ String($json.messages?.[0]?.from ?? '').replace(/[^0-9]/g, '') }}", "type": "string" },
            { "id": "m2", "name": "command", "value": "={{ ($json.messages?.[0]?.text?.body ?? $json.messages?.[0]?.interactive?.button_reply?.id ?? '').trim().split(/\\s+/)[0].toUpperCase() }}", "type": "string" },
            { "id": "m3", "name": "approvalId", "value": "={{ (($json.messages?.[0]?.text?.body ?? $json.messages?.[0]?.interactive?.button_reply?.id ?? '').trim().split(/\\s+/)[1] ?? '').toUpperCase() }}", "type": "string" },
            { "id": "m4", "name": "editText", "value": "={{ ($json.messages?.[0]?.text?.body ?? $json.messages?.[0]?.interactive?.button_reply?.id ?? '').trim().replace(/^\\S+\\s+\\S+\\s*/, '') }}", "type": "string" }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "ce37d9cc-f37b-436c-a28c-0dfc5b66ab96",
      "name": "Parse Command",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [720, 304]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 1 },
          "conditions": [
            {
              "leftValue": "={{ String($('Config').item.json.ownerWhatsApp).replace(/[^0-9]/g, '').length > 5 }}",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "rightValue": ""
            },
            {
              "leftValue": "={{ $json.fromNumber }}",
              "operator": { "type": "string", "operation": "equals" },
              "rightValue": "={{ String($('Config').item.json.ownerWhatsApp).replace(/[^0-9]/g, '') }}"
            },
            {
              "leftValue": "={{ [\"APPROVE\",\"REJECT\",\"EDIT\"].includes($json.command) }}",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "829d1ef4-c253-47b0-a27e-95e01a7116d6",
      "name": "Authorized Number & Valid Command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [960, 304]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "id", "value": "YOUR_DATA_TABLE_ID", "cachedResultName": "email_assistant_log" },
        "matchType": "allConditions",
        "filters": { "conditions": [ { "keyName": "approvalId", "keyValue": "={{ $json.approvalId }}" } ] },
        "limit": 1
      },
      "id": "bfd4b82d-f9d4-48be-a338-c4d044d4b8c5",
      "name": "Lookup Approval Request",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [1216, 288],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 1 },
          "conditions": [
            {
              "leftValue": "={{ $json.approvalId ?? '' }}",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "40310360-611c-4317-b47f-0389be055bc5",
      "name": "Request Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1440, 288]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e1",
              "name": "route",
              "value": "={{ $json.approvalStatus !== 'PENDING' ? 'processed' : ($now.toUTC().toISO() > $json.expiresAtIso ? 'expired' : ($('Parse Command').item.json.command === 'REJECT' ? 'reject' : ($('Parse Command').item.json.command === 'EDIT' && !$('Parse Command').item.json.editText ? 'edit_empty' : 'send'))) }}",
              "type": "string"
            },
            { "id": "e2", "name": "command", "value": "={{ $('Parse Command').item.json.command }}", "type": "string" },
            { "id": "e3", "name": "finalReply", "value": "={{ $('Parse Command').item.json.command === 'EDIT' ? $('Parse Command').item.json.editText : $json.aiDraft }}", "type": "string" },
            { "id": "e4", "name": "newApprovalStatus", "value": "={{ $('Parse Command').item.json.command === 'EDIT' ? 'APPROVED_EDITED' : 'APPROVED' }}", "type": "string" }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "62041dc4-5a94-49ea-9ea5-136ed0d2f14a",
      "name": "Evaluate Request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1712, 128]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
                "conditions": [ { "leftValue": "={{ $json.route }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "expired" } ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "expired"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
                "conditions": [ { "leftValue": "={{ $json.route }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "processed" } ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "already processed"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
                "conditions": [ { "leftValue": "={{ $json.route }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "edit_empty" } ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "edit without text"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
                "conditions": [ { "leftValue": "={{ $json.route }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "reject" } ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "reject"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 },
                "conditions": [ { "leftValue": "={{ $json.route }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "send" } ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "approve or edit"
            }
          ]
        },
        "options": {}
      },
